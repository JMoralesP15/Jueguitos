# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only values. Never prefix secrets with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=replace-with-local-secret-key

# Cloudflare deployment. Configure these as GitHub environment secrets.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
